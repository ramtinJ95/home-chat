{
  // Browser script: compiles app.ts to app.js next to it (git-ignored, built in the Docker image).
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": [],
    "strict": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "files": ["app.ts"]
}

{
  // Browser scripts: compiles app.ts and theme.ts to .js next to them (git-ignored, built in the Docker image).
  // skipLibCheck stays off so this project type-checks src/api.d.ts; it has no dependency typings to slow it down.
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "verbatimModuleSyntax": true
  },
  "files": ["app.ts", "theme.ts"]
}

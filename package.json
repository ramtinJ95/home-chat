{
  "name": "home-chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.9.0"
  },
  "scripts": {
    "start": "node src/server.ts",
    "build": "tsc -p public && tsc -p public/tsconfig.sw.json",
    "typecheck": "tsc -p . && tsc -p public --noEmit && tsc -p public/tsconfig.sw.json --noEmit",
    "test": "npm run build && node --test test/*.test.ts"
  },
  "dependencies": {
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "croner": "10.0.1",
    "ipaddr.js": "2.2.0",
    "sharp": "0.35.5",
    "typebox": "1.3.27",
    "undici": "8.10.2",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/web-push": "3.6.4",
    "playwright-core": "1.64.0",
    "typescript": "7.0.2"
  }
}

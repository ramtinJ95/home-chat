# Public deployment settings for home-macmini. Copy to .env next to compose.yaml, fill in, `chmod 600 .env`.
# .env is git-ignored; real emails and the tunnel token never go in the repository.
COMPOSE_FILE=compose.yaml:compose.public.yaml

# Public hostname routed by the tunnel; must match the tunnel's HTTP Host Header setting.
HOME_CHAT_PUBLIC_HOST=home-chat.handmadeoasis.com
# Zero Trust team name: the <team> in <team>.cloudflareaccess.com.
HOME_CHAT_ACCESS_TEAM=
# Application Audience (AUD) tag of the Access application.
HOME_CHAT_ACCESS_AUD=
# Google accounts allowed in, besides the Access policy. The guest is optional.
HOME_CHAT_OWNER_EMAIL=
HOME_CHAT_GUEST_EMAIL=
# Token of the dashboard-managed tunnel.
HOME_CHAT_TUNNEL_TOKEN=
# Exa API key for deep research. Optional: without it the app hides the Deep research switch.
EXA_API_KEY=
